# Supabase development project connection
# Copy this file to .env.local for local development and replace the placeholders.
# Never commit real credentials.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-reference.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Public production address used in emailed tracking links.
NEXT_PUBLIC_SITE_URL=https://afos-platform.vercel.app

# Optional email delivery. The app still provides a receipt when these are absent.
RESEND_API_KEY=re_your_key
AFOS_EMAIL_FROM=AFOS <requests@your-verified-domain.com>
